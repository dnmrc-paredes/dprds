---
import { company } from "@/data/company";
---

<section id="work">
	<h2>Experience</h2>
	<div class="role-header">
		<div>
			<h3 class="role-title">{company.role}</h3>
			<div class="role-place">{company.name} · {company.location}</div>
		</div>
		<span class="role-period">{company.period}</span>
	</div>
	<p class="role-summary">{company.summary}</p>

	<div class="proj-list">
		{
			company.projects.map((p) => (
				<div class="proj">
					<div class="proj-head">
						<h3 class="proj-title">{p.name}</h3>
						<span class="pill">{p.stack}</span>
					</div>
					<ul>
						{p.points.map((pt) => <li>{pt}</li>)}
					</ul>
				</div>
			))
		}
	</div>

	<div class="hl-wrap">
		<div class="hl-label">Highlights</div>
		<ul class="hl-list">
			{company.highlights.map((h) => <li>{h}</li>)}
		</ul>
	</div>
</section>
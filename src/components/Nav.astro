---
---

<header>
    <div class="wrap nav-inner">
        <a class="brand" href="/">dprds</a>
        <button
            class="nav-toggle"
            id="navToggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="navMenu"
        >
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
        </button>
        <nav class="nav-links" id="navMenu">
            <a href="#work">Work</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
            <button class="theme-btn" id="themeToggle" aria-label="Toggle theme"></button>
        </nav>
    </div>
</header>

<style>
    header {
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        z-index: 10;
    }

    .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 56px;
        position: relative;
    }

    .brand {
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        text-decoration: none;
        color: var(--fg);
    }

    /* Mobile-first: hamburger toggle */
    .nav-toggle {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: none;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 8px;
        cursor: pointer;
    }

    .nav-toggle-bar {
        display: block;
        width: 20px;
        height: 2px;
        background: var(--fg);
        transition: transform 0.2s, opacity 0.2s;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
        opacity: 0;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile-first: mobile menu collapsed by default */
    .nav-links {
        position: absolute;
        top: calc(100% + 1px);
        left: 0;
        right: 0;
        padding: 0 1.5rem;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        display: none;
        flex-direction: column;
        gap: 0.25rem;
    }

    .nav-links.open {
        display: flex;
        padding-bottom: 1rem;
    }

    .nav-links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--line);
    }

    .nav-links a:hover {
        color: var(--fg);
    }

    .nav-links .theme-btn {
        margin-top: 1rem;
        align-self: flex-start;
    }

    .theme-btn {
        background: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        color: var(--fg);
        font-size: 1rem;
        display: grid;
        place-items: center;
    }

    /* Desktop: hide hamburger, show links in a row */
    @media (min-width: 640px) {
        .nav-toggle {
            display: none;
        }

        .nav-links {
            position: static;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 1.25rem;
            padding: 0;
            background: none;
            border-bottom: none;
        }

        .nav-links a {
            padding: 0;
            border-bottom: none;
            font-size: 0.9rem;
        }

        .nav-links .theme-btn {
            margin-top: 0;
            align-self: auto;
        }
    }
</style>

<script>
    const btn = document.getElementById("themeToggle");
    const sun = "☀";
    const moon = "☾";
    const apply = () => {
        const t = document.documentElement.dataset.theme;
        btn.textContent = t === "dark" ? sun : moon;
    };
    apply();
    btn.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        apply();
    });

    const navToggle = document.getElementById("navToggle");
    const navMenu = document.getElementById("navMenu");
    navToggle.addEventListener("click", () => {
        const open = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", String(!open));
        navToggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        navMenu.classList.toggle("open", !open);
    });
    navMenu.addEventListener("click", (e) => {
        if (e.target.tagName === "A") {
            navToggle.setAttribute("aria-expanded", "false");
            navToggle.setAttribute("aria-label", "Open menu");
            navMenu.classList.remove("open");
        }
    });
</script>
